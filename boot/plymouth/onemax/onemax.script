# OneMax boot splash: Plymouth script theme.
#
# Plymouth script language: https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/
#
# Layout constants mirror scripts/build-boot-assets.py, which renders the
# boot/preview/*.png images with the same formulas. Keep both files in sync.
#
# The theme draws only PNG images (no text), so it needs no fonts in the initramfs.

# --- Background --------------------------------------------------------------
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;

# UI scale: 1.0 at 1080p, 2.0 at 2160p.
ui_scale = screen_h / 1080;
if (ui_scale < 0.5) { ui_scale = 0.5; }

# --- Logo --------------------------------------------------------------------
logo_src = Image("logo.png");
logo_w = Math.Int(screen_w * 0.36);
logo_h = Math.Int(logo_src.GetHeight() * logo_w / logo_src.GetWidth());
logo_scaled = logo_src.Scale(logo_w, logo_h);
logo_sprite = Sprite(logo_scaled);
logo_sprite.SetPosition(Math.Int(center_x - logo_w / 2), Math.Int(screen_y + screen_h * 0.42 - logo_h / 2), 10);
logo_alpha = 0;
logo_sprite.SetOpacity(logo_alpha);

# --- Progress bar ------------------------------------------------------------
bar_w = Math.Int(screen_w * 0.22);
bar_h = Math.Int(10 * ui_scale);
if (bar_h < 4) { bar_h = 4; }
bar_x = Math.Int(center_x - bar_w / 2);
bar_y = Math.Int(screen_y + screen_h * 0.70);

track_src = Image("progress-track.png");
track_sprite = Sprite(track_src.Scale(bar_w, bar_h));
track_sprite.SetPosition(bar_x, bar_y, 20);

fill_src = Image("progress-fill.png");
fill_sprite = Sprite();
fill_sprite.SetPosition(bar_x, bar_y, 21);
fill_sprite.SetOpacity(0);
fill_width = -1;          # forces the fill to be drawn on the first refresh
progress_target = 0;
progress_shown = 0;

# --- Passphrase prompt (LUKS) ------------------------------------------------
MAX_DOTS = 24;
password_active = 0;

lock_src = Image("lock.png");
lock_size = Math.Int(64 * ui_scale);
lock_sprite = Sprite(lock_src.Scale(lock_size, lock_size));
lock_sprite.SetPosition(Math.Int(center_x - lock_size / 2), Math.Int(bar_y - lock_size - 24 * ui_scale), 30);
lock_sprite.SetOpacity(0);

dot_size = Math.Int(14 * ui_scale);
if (dot_size < 6) { dot_size = 6; }
dot_spacing = Math.Int(dot_size * 1.8);
dot_src = Image("dot.png");
dot_scaled = dot_src.Scale(dot_size, dot_size);
for (i = 0; i < MAX_DOTS; i++)
{
    dot_sprite[i] = Sprite(dot_scaled);
    dot_sprite[i].SetZ(31);
    dot_sprite[i].SetOpacity(0);
}

# --- Callbacks ---------------------------------------------------------------

# Boot progress (0..1). The bar eases towards this value.
fun boot_progress_callback(duration, progress)
{
    progress_target = progress;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# Refresh callback, called up to 50 times per second.
fun refresh_callback()
{
    # The logo fades in during the first second.
    if (logo_alpha < 1)
    {
        logo_alpha += 0.02;
        if (logo_alpha > 1) { logo_alpha = 1; }
        logo_sprite.SetOpacity(logo_alpha);
    }

    if (password_active == 0)
    {
        if (progress_target > 1) { progress_target = 1; }
        if (progress_target < 0) { progress_target = 0; }

        gap = progress_target - progress_shown;
        if (gap > 0.001) { progress_shown += gap * 0.08; }
        else { progress_shown = progress_target; }

        new_w = Math.Int(bar_w * progress_shown);
        if (new_w != fill_width)
        {
            fill_width = new_w;
            if (new_w > 0)
            {
                fill_sprite.SetImage(fill_src.Scale(new_w, bar_h));
                fill_sprite.SetOpacity(1);
            }
            else
            {
                fill_sprite.SetOpacity(0);
            }
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# A passphrase is requested. bullets = number of characters typed so far.
fun display_password_callback(prompt, bullets)
{
    password_active = 1;
    track_sprite.SetOpacity(0);
    fill_sprite.SetOpacity(0);
    lock_sprite.SetOpacity(1);

    shown = 0;
    if (bullets) { shown = bullets; }
    if (shown > MAX_DOTS) { shown = MAX_DOTS; }
    start_x = center_x - ((shown - 1) * dot_spacing + dot_size) / 2;

    for (i = 0; i < MAX_DOTS; i++)
    {
        if (i < shown)
        {
            dot_sprite[i].SetPosition(Math.Int(start_x + i * dot_spacing), bar_y, 31);
            dot_sprite[i].SetOpacity(1);
        }
        else
        {
            dot_sprite[i].SetOpacity(0);
        }
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# The passphrase prompt is finished: return to the progress bar.
fun display_normal_callback()
{
    password_active = 0;
    lock_sprite.SetOpacity(0);
    for (i = 0; i < MAX_DOTS; i++)
    {
        dot_sprite[i].SetOpacity(0);
    }
    track_sprite.SetOpacity(1);
    fill_width = -1;      # redraw the fill on the next refresh
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
