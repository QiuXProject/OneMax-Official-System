# OneMax kernel fragment (x86_64).
# Merged on top of os/kernel/base-6.1.158.config with scripts/kconfig/merge_config.sh.
#
# Goal: the live ISO and the installed BIOS disk image must boot on real PCs and in
# VirtualBox/QEMU: AHCI/IDE/SCSI-CD/virtio disks, e1000/PCnet/virtio NICs,
# EFI/VESA/simpledrm framebuffers, PS/2 and USB input.

CONFIG_LOCALVERSION="-onemax"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="onemax"

# objtool is required by x86_64 (static calls, retpolines, ftrace) and is built from the
# kernel tree. The build host has no libelf-dev, so scripts/build-os.sh builds libelf
# (arachsys/libelf, tag v0.194) from source. Stack validation is not needed here.
# CONFIG_STACK_VALIDATION is not set

# Frame-pointer unwinder instead of ORC: simpler and needs no ORC data generation.
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set

# early boot: initramfs and devices
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# live root: squashfs + overlayfs on a loop device
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y

# filesystems: installed system (ext4), ISO media (iso9660), USB sticks (vfat)
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# block devices: AHCI (SATA), PIIX (IDE), SCSI CD-ROM, virtio
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

# network: Intel e1000/e1000e (VirtualBox default NIC), AMD PCnet, virtio-net
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VIRTIO_NET=y

# systemd: autofs, binfmt_misc, cgroups, user namespaces
CONFIG_AUTOFS4_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_CGROUPS=y
CONFIG_USER_NS=y

# graphics: EFI and VESA framebuffers, simpledrm, VMware SVGA, virtio-gpu, bochs
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y

# input: PS/2 keyboard and mouse, USB host controllers and HID
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# consoles
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# OneMax boot logo: drawn by the kernel on the framebuffer console (replaces the Tux logo).
# scripts/build-os.sh generates drivers/video/logo/logo_linux_clut224.ppm from
# branding/onemax-logo.png (scripts/make-kernel-logo.py, at most 224 colours).
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
